# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha.
#   cp .env.example .env.local
# NUNCA comite o .env.local — ele está no .gitignore.
# ---------------------------------------------------------------------------

# --- Supabase (Settings -> API) ---------------------------------------------
# Público, seguro no browser:
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SEGREDO. Só no servidor. Nunca com prefixo NEXT_PUBLIC_.
# Usada apenas em webhooks e jobs (cria cliente que IGNORA RLS).
SUPABASE_SECRET_KEY=sb_secret_...

# --- Aplicação ---------------------------------------------------------------
# URL pública usada nos links wa.me e nos redirects de auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini (opcional, não usado) ---------------------------------------------
# A F2 usou catálogo fixo (20 jogadores x 4 cores) em vez de parser de foto,
# então esta chave é ignorada pelo app. Pode ficar vazia.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Mercado Pago (Fase 3: cobranças Pix) -------------------------------------
# https://www.mercadopago.com.br/developers/panel/applications
# A tela de Configuração mostra se estas chaves estão preenchidas (nunca o valor).
# Access Token do app (Suas integrações > seu app > Credenciais de produção).
MP_ACCESS_TOKEN=
# Segredo usado no path do webhook: /api/webhooks/mercadopago/<MP_WEBHOOK_TOKEN>
# Sem ele, a confirmação de pagamento fica manual na tela de Cobranças.
# Depois de definir, cadastre a URL completa no painel do MP:
#   Suas integrações > seu app > Webhooks > Configurar notificações >
#   modo de produção > evento "Order (Mercado Pago)".
# (A Orders API não aceita notification_url no body — o cadastro é manual.)
MP_WEBHOOK_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks > Configure
# notificação > revele a chave). Valida o header x-signature (HMAC-SHA256).
# OBRIGATÓRIO em produção: sem ele a rota só avisa no log e não autentica
# a origem da notificação.
MP_WEBHOOK_SECRET=

# --- SuperFrete (Fase 4: cotação e etiquetas) --------------------------------
# https://sandbox.superfrete.com/#/integrations  (testes)
# https://web.superfrete.com/#/integrations      (produção)
# O webhook NÃO se cadastra aqui: a tela de Envios tem o botão "Ativar webhook",
# que cria o app na SuperFrete e grava o secret em app_secrets (não em
# app_settings — esta é pública no browser).
SUPERFRETE_TOKEN=
SUPERFRETE_SANDBOX=true
SUPERFRETE_USER_AGENT=CarasLegendsCRM (seu-email@exemplo.com)

# --- WhatsApp Cloud API (Fase opcional: OTP e anexo de mídia) ----------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
